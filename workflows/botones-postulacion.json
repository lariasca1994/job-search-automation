        {
            "id": "14736798-3858-4f0c-b64b-a95bcc792ed8",
            "name": "Resolver filas",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                672,
                0
            ],
            "parameters": {
                "jsCode": "// Busca la fila de cada botón por la huella de su URL y arma la actualización de la planilla.\n// Si se tocaron los dos botones de una oferta, vale el último.\nconst huella = (u) => String(u).split('').reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0, 2166136261).toString(36);\nconst token = $env.TELEGRAM_BOT_TOKEN;\nconst filas = {};\nfor (const i of $('Leer planilla').all()) if (i.json.url) filas[huella(i.json.url)] = i.json;\n\nconst ultimos = {};\nfor (const i of $('Leer botones').all()) ultimos[i.json.id] = i.json;\n\nconst hoy = $now.toFormat('yyyy-MM-dd');\nconst out = [];\nfor (const b of Object.values(ultimos)) {\n  const fila = filas[b.id];\n  if (!fila) {\n    try {\n      await this.helpers.httpRequest({\n        method: 'POST', url: `https://api.telegram.org/bot${token}/answerCallbackQuery`, json: true,\n        body: { callback_query_id: b.callback_id, show_alert: true,\n                text: 'No encontré esta oferta en la planilla: márcala a mano en la columna estado.' },\n      });\n    } catch (e) { /* el toque pudo vencer: no detiene el resto */ }\n    continue;\n  }\n  out.push({ json: b.accion === 'a'\n    ? { url: fila.url, estado: 'Postulado', fecha_postulacion: fila.fecha_postulacion || hoy }\n    : { url: fila.url, estado: 'Descartado', fecha_postulacion: '' } });\n}\nreturn out;"
            }
        },
