        {
            "id": "c9d3542a-88dd-4fcc-b480-3b7c31ea0ef7",
            "name": "Leer botones",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                224,
                0
            ],
            "parameters": {
                "jsCode": "// Lee los botones \"Apliqué / No apliqué\" tocados en Telegram. Consulta getUpdates, así que la\n// VM no necesita quedar expuesta a internet. Telegram guarda los toques 24 h: los que llegan\n// con la VM apagada se procesan al encenderse. Solo se aceptan los del chat configurado.\nconst token = $env.TELEGRAM_BOT_TOKEN;\nconst chat = String($env.TELEGRAM_CHAT_ID);\nconst estado = $getWorkflowStaticData('global');\n\nconst r = await this.helpers.httpRequest({\n  method: 'POST',\n  url: `https://api.telegram.org/bot${token}/getUpdates`,\n  body: { offset: estado.offset || 0, timeout: 0, allowed_updates: ['callback_query'] },\n  json: true,\n});\nconst updates = r.result || [];\n// El avance se guarda solo si la ejecución termina bien: si falla la planilla, se reintenta\nif (updates.length) estado.offset = updates[updates.length - 1].update_id + 1;\n\nconst out = [];\nfor (const u of updates) {\n  const cb = u.callback_query;\n  if (!cb || !cb.message || String(cb.message.chat.id) !== chat) continue;\n  const m = /^([an]):([a-z0-9]+)$/.exec(cb.data || '');\n  if (!m) continue;\n  out.push({ json: {\n    accion: m[1],\n    id: m[2],\n    callback_id: cb.id,\n    chat_id: cb.message.chat.id,\n    message_id: cb.message.message_id,\n    teclado: (cb.message.reply_markup || {}).inline_keyboard || [],\n  } });\n}\nreturn out;"
            }
        },
        {
            "parameters": {
