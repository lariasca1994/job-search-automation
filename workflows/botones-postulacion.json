        {
            "id": "2cd840bb-0e7e-47e3-9072-3dba2dcc7c2e",
            "name": "Confirmar en Telegram",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1120,
                0
            ],
            "executeOnce": true,
            "parameters": {
                "jsCode": "// Confirma en Telegram lo que quedó en la planilla y marca en el mensaje la opción elegida\n// (los dos botones siguen disponibles por si hay que cambiarla).\nconst huella = (u) => String(u).split('').reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0, 2166136261).toString(36);\nconst token = $env.TELEGRAM_BOT_TOKEN;\nconst tg = async (metodo, body) => {\n  try {\n    await this.helpers.httpRequest({ method: 'POST', url: `https://api.telegram.org/bot${token}/${metodo}`, body, json: true });\n  } catch (e) { /* un toque vencido o un mensaje sin cambios no detiene el resto */ }\n};\n\nconst estados = {};\nfor (const i of $('Resolver filas').all()) estados[huella(i.json.url)] = i.json.estado;\n\nconst mensajes = {};\nfor (const { json: b } of $('Leer botones').all()) {\n  const estado = estados[b.id];\n  if (!estado) continue;\n  await tg('answerCallbackQuery', {\n    callback_query_id: b.callback_id,\n    text: estado === 'Postulado' ? 'Registrado: te postulaste' : 'Registrado: no aplicaste',\n  });\n  mensajes[`${b.chat_id}:${b.message_id}`] = { b, estado };\n}\nfor (const { b, estado } of Object.values(mensajes)) {\n  const teclado = b.teclado.filter((fila) => !fila.some((x) => x.callback_data));\n  teclado.push([\n    { text: (estado === 'Postulado' ? '● ' : '') + '✅ Apliqué', callback_data: 'a:' + b.id },\n    { text: (estado === 'Descartado' ? '● ' : '') + '❌ No apliqué', callback_data: 'n:' + b.id },\n  ]);\n  await tg('editMessageReplyMarkup', { chat_id: b.chat_id, message_id: b.message_id, reply_markup: { inline_keyboard: teclado } });\n}\nreturn [{ json: { procesados: Object.keys(mensajes).length } }];"
            }
        }
