        {
            "parameters": {
                "jsCode": "// Resumen del dia: ofertas con match >= 83% que todavia no se notificaron, con el link a la\n// HV adaptada si ya esta lista. Usa parse_mode HTML escapando el texto: con Markdown, un\n// titulo con \"_\" o \"*\" hacia que Telegram rechazara el mensaje completo (error 400) en silencio.\nconst UMBRAL = 83;\nconst cfg = $('Config (Telegram)').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n\nconst items = $input.all().map((i) => i.json)\n  .filter((j) => j.url && Number(j.match_pct) >= UMBRAL && !String(j.notificado ?? '').trim())\n  .sort((a, b) => Number(b.match_pct) - Number(a.match_pct))\n  .slice(0, 20); // 4 fuentes x 5 ofertas\n\nlet texto;\nif (!items.length) {\n  texto = '✅ Busqueda de hoy terminada: no hubo ofertas nuevas con match de ' + UMBRAL + '% o mas.';\n} else {\n  const lineas = items.map((j, idx) => {\n    const doc = String(j.hv_adaptada || '').startsWith('http');\n    const pdf = String(j.hv_pdf || '').startsWith('http');\n    const hv = doc || pdf\n      ? '\\n   📄 HV: ' + [pdf ? '<a href=\"' + esc(j.hv_pdf) + '\">PDF</a>' : '', doc ? '<a href=\"' + esc(j.hv_adaptada) + '\">Google Docs</a>' : ''].filter(Boolean).join(' · ')\n      : '\\n   📄 HV adaptada: pendiente';\n    return (idx + 1) + '. <b>' + esc(j.titulo) + '</b> - ' + esc(j.empresa) +\n      '\\n   📍 ' + esc(j.ubicacion) + ' | 🎯 ' + esc(j.match_pct) + '% | ' + esc(j.fuente) +\n      '\\n   💡 ' + esc(j.ats_tip) + hv;\n  });\n  texto = '🔥 <b>Ofertas con match ≥ ' + UMBRAL + '% de hoy</b> (' + items.length + ')\\n\\n' + lineas.join('\\n\\n');\n}\nif (texto.length > 4000) texto = texto.slice(0, 3990) + '\\n…';\n\nconst payload = { chat_id: cfg.telegram_chat_id, text: texto, parse_mode: 'HTML', disable_web_page_preview: true };\nif (items.length) {\n  payload.reply_markup = { inline_keyboard: items.map((j) => ([{ text: '🔗 ' + String(j.titulo || 'Oferta').slice(0, 40), url: j.url }])) };\n}\nreturn [{ json: { payload, urls: items.map((j) => j.url) } }];\n"
            },
            "id": "bfb4c4ec-f873-4770-8e0e-c2d128a543c5",
            "name": "Armar resumen",
            "type": "n8n-nodes-base.code",
