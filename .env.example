# Copia este archivo a .env (cp .env.example .env) y completa tus valores.
# El .env NUNCA se sube a git (ver .gitignore).
# Una variable por linea: si dos quedan pegadas en la misma linea, la segunda
# desaparece sin ningun error visible.

# ============================================================
# 1. Secretos
# ============================================================

# API key de Gemini (Google AI Studio, nivel gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo principal. Si se queda sin cuota o esta saturado, los workflows
# pasan solos a gemini-flash-lite-latest y luego a gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash

# Bot de Telegram: crealo con @BotFather y pega el token.
TELEGRAM_BOT_TOKEN=
# Tu chat_id de Telegram (escribele a @userinfobot para conocerlo).
TELEGRAM_CHAT_ID=

# ============================================================
# 2. Tus datos
# ============================================================

# ID de tu Google Sheet (lo que va entre /d/ y /edit en la URL).
# Se usa la PRIMERA pestana, con los encabezados del README.
SHEET_ID=

# Tu hoja de vida base en texto plano, en UNA sola linea, con los saltos
# de linea escritos como \n. Linea 1: tu nombre. Linea 2: tus datos de
# contacto (con tus enlaces). Lo demas: perfil, experiencia, formacion, etc.
HV_BASE_TEXT=NOMBRE APELLIDO\nTelefono | correo@ejemplo.com | LinkedIn: https://... | Portafolio: https://...\n\nPERFIL PROFESIONAL\n...

# Prefijo del nombre de los archivos: <prefijo>_<Oferta> (Doc y PDF).
# Obligatorio (minimo 5 caracteres): la limpieza de los viernes SOLO borra
# archivos cuyo nombre empieza con este prefijo.
HV_PREFIJO_ARCHIVO=HV_Nombre_Apellido

# Carpeta del Drive donde se guardan las HV (se crea sola la primera vez).
DRIVE_CARPETA=HV

# ============================================================
# 3. Tu pais y tu busqueda
# ============================================================

# Zona horaria de los horarios (formato IANA): America/Mexico_City,
# America/Argentina/Buenos_Aires, America/Lima, Europe/Madrid...
ZONA_HORARIA=

# Pais (contexto para la IA al evaluar ofertas y redactar la HV). Ej: Mexico
PAIS=

# Perfiles y keywords a buscar, en JSON y en una sola linea (entre comillas simples).
PERFILES_BUSQUEDA='[{"perfil": "Soporte IT", "keywords": ["soporte tecnico", "mesa de ayuda"]}, {"perfil": "QA Testing", "keywords": ["analista qa", "pruebas funcionales"]}]'

# Que ubicaciones se aceptan (regex, sin distinguir mayusculas). Ejemplo:
# tu ciudad + remoto/hibrido. Con "." se acepta cualquier ubicacion.
ZONA_REGEX=(ciudad|remoto|remote|h[ií]brido)

# Opcional: regex de puestos/rubros a descartar. Si lo dejas vacio se usan
# los filtros por defecto del nodo "Filtrar (descartar dealbreakers)".
EXCLUIR_PUESTO_REGEX=
EXCLUIR_RUBRO_REGEX=

# Ubicacion tal como la escribe cada portal en sus URLs de busqueda.
# Computrabajo tiene un dominio por pais: co., mx., ar., pe., cl., ec. ...
COMPUTRABAJO_DOMINIO=co.computrabajo.com
UBICACION_COMPUTRABAJO=ciudad-slug
# Elempleo y Magneto365 solo operan en Colombia: fuera de alli, desactiva esos workflows.
UBICACION_ELEMPLEO=ciudad
UBICACION_MAGNETO=ciudad
# LinkedIn: texto libre, como en su buscador.
UBICACION_LINKEDIN=Ciudad, Pais

# ============================================================
# 4. Acceso al editor (opcional)
# ============================================================
# Por defecto n8n solo escucha en localhost y se entra por tunel SSH.
# N8N_HOST=localhost
# N8N_PROTOCOL=http
# WEBHOOK_URL=http://localhost:5678/
