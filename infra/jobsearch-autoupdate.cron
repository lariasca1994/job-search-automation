# Sincroniza la VM con main cada 5 minutos mientras está encendida. Sin cambios, no toca n8n;
# con --cron, tampoco lo detiene de 9:00 a 12:00 (hora de ZONA_HORARIA), mientras corren
# los workflows. La VM está en UTC: por eso el horario lo decide el script y no esta línea.
*/5 * * * * root /usr/local/bin/actualizar-n8n.sh --cron > /var/log/autoupdate.log 2>&1
